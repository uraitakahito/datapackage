---
/**
 * banner の中の内部リンクに base を付ける。
 *
 * `banner.content` は frontmatter の YAML に書かれた **生の HTML 文字列**で、
 * Astro はそこを一切書き換えない。`import.meta.env` も届かないので、
 * `<a href="/overview/changelog/">` は base 配下に置かれた fork では 404 に
 * なる —— Markdown リンクなら Astro が補ってくれる場所が、ここだけ穴になる。
 *
 * 上流の Banner.astro をそのまま写し、`set:html` に渡す直前で先頭 `/` の
 * href だけを書き換える。`//` で始まるものはプロトコル相対 URL なので除く。
 */
import type { Props } from "@astrojs/starlight/props"

const { banner } = Astro.props.entry.data
const base = import.meta.env.BASE_URL.replace(/\/+$/, "")
const content = banner?.content.replace(/href="\/(?!\/)/g, `href="${base}/`)
---

{content && <div class="sl-banner" set:html={content} />}

<style>
  .sl-banner {
    --__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
    color: var(--__sl-banner-text);
    line-height: var(--sl-line-height-headings);
    text-align: center;
    text-wrap: balance;
    box-shadow: var(--sl-shadow-sm);
  }
  .sl-banner :global(a) {
    color: var(--__sl-banner-text);
  }
</style>
